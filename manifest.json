{
  "manifest_version": 3,
  "name": "Web2HTML Studio",
  "version": "1.0.0",
  "description": "智能捕获网页结构与样式，快速生成可编辑设计数据。© Tomda (https://www.tomda.top) / UIED技术团队 (https://fsuied.com)",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Web2HTML Studio",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.js",
        "runner.js",
        "inpage-toolbar.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
